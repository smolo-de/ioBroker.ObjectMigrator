{
    "name": "iobroker.objectmigrator",
    "version": "0.0.1",
    "description": "Migrate object settings and history data to alias objects or objects of another adapter",
    "author": {
        "name": "smolo-de",
        "email": "9969181+smolo-de@users.noreply.github.com"
    },
    "contributors": [],
    "homepage": "https://github.com/smolo-de/ioBroker.objectmigrator",
    "license": "MIT",
    "keywords": [
        "alias",
        "migration",
        "history",
        "settings",
        "custom"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/smolo-de/ioBroker.objectmigrator.git"
    },
    "engines": {
        "node": ">= 22"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^6.3.2",
        "@mui/material": "^9.5.0",
        "@tanstack/react-virtual": "^3.14.26",
        "@tsconfig/node22": "^22.0.7",
        "@types/iobroker": "npm:@iobroker/types@^7.2.5",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "echarts": "^6.1.0",
        "nyc": "^18.0.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "rimraf": "^6.1.4",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3",
        "vite": "^8.3.8"
    },
    "main": "build/main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "admin/build/",
        "build/",
        "www/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "build-adapter ts && npm run build:tab",
        "watch": "build-adapter ts --watch",
        "prebuild:ts": "rimraf build",
        "build:ts": "build-adapter ts",
        "watch:ts": "build-adapter ts --watch",
        "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\" \"src-admin/src/**/*.test.ts\"",
        "test:package": "mocha test/package --exit",
        "test:integration": "mocha test/integration --exit",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit && tsc -p src-admin/tsconfig.json",
        "coverage": "nyc npm run test:ts",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter",
        "release": "release-script",
        "dev:start": "node .dev-server/default/node_modules/iobroker.js-controller/controller.js",
        "dev:deploy": "npm run build && node scripts/dev-deploy.js",
        "build:tab": "rimraf admin/build && vite build --config src-admin/vite.config.ts",
        "test:e2e": "mocha --timeout 900000 test/e2e/*.test.js"
    },
    "nyc": {
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "src/**/*.test.ts"
        ],
        "extension": [
            ".ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "reporter": [
            "text-summary",
            "html"
        ],
        "sourceMap": true,
        "instrument": true
    },
    "bugs": {
        "url": "https://github.com/smolo-de/ioBroker.objectmigrator/issues"
    },
    "readmeFilename": "README.md"
}

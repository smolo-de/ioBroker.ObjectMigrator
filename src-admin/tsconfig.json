{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "types": ["@types/iobroker"]
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
    "exclude": ["src/**/*.test.ts"]
}
